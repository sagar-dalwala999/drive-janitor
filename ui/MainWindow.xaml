<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drive Janitor" Height="760" Width="960" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: drive bars -->
            <RowDefinition Height="Auto"/>  <!-- 1: toolbar -->
            <RowDefinition Height="Auto"/>  <!-- 2: advanced panel -->
            <RowDefinition Height="Auto"/>  <!-- 3: progress panel -->
            <RowDefinition Height="*"/>     <!-- 4: findings -->
            <RowDefinition Height="Auto"/>  <!-- 5: result panel -->
            <RowDefinition Height="Auto"/>  <!-- 6: footer -->
        </Grid.RowDefinitions>

        <!-- Drive bars -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="12" Margin="0,0,0,10"
                BorderBrush="#DDDDDD" BorderThickness="1">
            <StackPanel x:Name="DrivePanel"/>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <Button x:Name="BtnScan" Content="Scan" Style="{StaticResource ToolbarButton}" DockPanel.Dock="Left" FontWeight="Bold"/>
            <Button x:Name="BtnDryRun" Content="Dry run" Style="{StaticResource ToolbarButton}" DockPanel.Dock="Left" IsEnabled="False"/>
            <Button x:Name="BtnClean" Content="Clean" Style="{StaticResource ToolbarButton}" DockPanel.Dock="Left" IsEnabled="False"/>
            <Button x:Name="BtnExportCsv" Content="Export CSV" Style="{StaticResource ToolbarButton}" DockPanel.Dock="Left" IsEnabled="False"/>
            <Button x:Name="BtnAdvancedToggle" Content="Advanced (show)" Style="{StaticResource ToolbarButton}" DockPanel.Dock="Right"/>
            <TextBlock x:Name="TxtStatus" Text="Ready" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#666666"/>
        </DockPanel>

        <!-- Advanced panel -->
        <Border x:Name="AdvancedPanel" Grid.Row="2" Background="White" CornerRadius="4" Padding="12" Margin="0,0,0,10"
                BorderBrush="#DDDDDD" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                    <TextBlock Text="Custom roots (one per line)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCustomRoots" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,0">
                    <TextBlock Text="Exclusion list (one path per line)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtExclusions" AcceptsReturn="True" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Min size (MB):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtMinSizeMB" Width="80" Text="0"/>
                    <TextBlock Text="Age threshold (days):" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <TextBox x:Name="TxtAgeDays" Width="80" Text="0"/>
                    <CheckBox x:Name="ChkFindDuplicates" Margin="16,0,0,0" VerticalAlignment="Center"
                              Content="Find duplicate projects (much slower)"
                              ToolTip="Compares projects to spot near-identical copies. Report-only, and roughly 60% of total scan time - leave off for routine cleanups."/>
                </StackPanel>

                <Button x:Name="BtnSaveAdvanced" Grid.Column="1" Grid.Row="1" Content="Save settings"
                        HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,6"/>

                <TextBlock x:Name="TxtAdvValidationError" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                           Text="" Foreground="#C62828" FontSize="11.5" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Progress panel -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,0,0,10" Visibility="Collapsed">
            <ProgressBar x:Name="ScanProgressBar" Height="18" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="TxtCurrentPath" Text="" Margin="0,4,0,0" Foreground="#666666" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Findings -->
        <Border Grid.Row="4" Background="White" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="TxtEmptyState" Text="Click Scan to find reclaimable space on C: and D:."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999999" FontSize="14"/>
                <ScrollViewer x:Name="FindingsScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel x:Name="FindingsPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Result panel -->
        <Border x:Name="ResultPanel" Grid.Row="5" Background="White" CornerRadius="4" Padding="14" Margin="0,10,0,0"
                BorderBrush="#DDDDDD" BorderThickness="1" Visibility="Collapsed">
            <StackPanel x:Name="ResultContent"/>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="TxtSelectedTotal" Text="Selected: 0 B" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
